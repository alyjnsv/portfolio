# Telegram Bot — уведомления о посещениях
# Получить токен бота: @BotFather в Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ID чата куда слать уведомления (ваш личный или группа)
# Узнать: напишите боту @userinfobot или @getidsbot
TELEGRAM_CHAT_ID=your_chat_id_here

# Ключ OpenRouter для живого AI-чата
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Модель для чата (опционально). По умолчанию google/gemma-4-31b-it:free
# OpenRouter периодически убирает :free модели — если чат перестал отвечать,
# проверьте актуальные: https://openrouter.ai/models?q=free
OPENROUTER_MODEL=google/gemma-4-31b-it:free
